{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"],
    "paths": {
      "stdlib": ["./stdlib/index.ts"],
      "stdlib/*": ["./stdlib/*"],
      "pkg/*": ["./app/pkg/*"],
      "pi-tools": ["./node_modules/@earendil-works/pi-coding-agent/dist/core/tools/index"],
      "pi-utils/*": ["./node_modules/@earendil-works/pi-coding-agent/dist/utils/*"]
    }
  },
  "include": ["stdlib", "app/pkg"]
}
