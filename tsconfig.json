{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"],
    "paths": {
      "stdlib": ["./stdlib/index.ts"],
      "stdlib/*": ["./stdlib/*"]
    }
  },
  "include": ["stdlib", "app"]
}
