# 复制为 .env 后填入
DEEPSEEK_API_KEY=
# 换 Claude 时填，并把 MODEL 改成 anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=
# 用哪个模型：provider/模型 id
MODEL=deepseek/deepseek-flash
# fs 插件的工作区目录
WORKSPACE_DIR=./workspace
# 持久状态的目录：写前日志（journal/，停下或进程被杀后再运行 bun start 接着做）、各插件的存储（store/，如对话历史）、
# HTTP 服务接口的 socket（harness.sock）；要在工作区之外
STATE_DIR=./.harness

# 沙盒应用（app/sandbox）：状态与工作区的根
SANDBOX_HOME=./.sandbox
# 管理口：端口与令牌（本机上可以不设令牌；监听在本机以外时必须设）
SANDBOX_ADMIN_PORT=8081
SANDBOX_ADMIN_TOKEN=
# 管理员的终端连哪（缺省本机的 SANDBOX_ADMIN_PORT）；连沙盒时填它的地址，如 https://8081-<沙盒 id>.e2b.app
SANDBOX_ADMIN_URL=
