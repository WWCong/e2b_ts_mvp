# 复制为 .env 后填入
DEEPSEEK_API_KEY=
# 换 Claude 时填，并把 MODEL 改成 anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=
# 用哪个模型：provider/模型 id
MODEL=deepseek/deepseek-flash
# fs 插件的工作区目录
WORKSPACE_DIR=./workspace
# 持久状态的目录：写前日志（journal/，停下或进程被杀后再运行 bun start 接着做）、各插件的存储（store/，如对话历史）、
# HTTP 服务接口的 socket（harness.sock）；要在工作区之外
STATE_DIR=./.harness

# builder（app/builder）：根（tree/ 是树，state/ 是持久状态）、端口与监听的地址、网关带调用者身份的请求头
BUILDER_HOME=./.builder
BUILDER_PORT=8090
BUILDER_HOST=127.0.0.1
BUILDER_USER_HEADER=x-builder-user
